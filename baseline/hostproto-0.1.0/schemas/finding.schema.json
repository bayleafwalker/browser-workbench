{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hostproto:schema:finding:0.1",
  "title": "hostproto finding 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_version",
    "id",
    "title",
    "status",
    "classification",
    "confidence",
    "scenario_ids",
    "evidence_refs",
    "summary",
    "raw_observation",
    "normalized_effect",
    "decision"
  ],
  "properties": {
    "finding_version": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^HP-F[0-9]{4}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "enum": ["open", "confirmed", "rejected", "upstreamed", "resolved"] },
    "classification": {
      "enum": [
        "semantic_mismatch",
        "unsupported_capability",
        "adapter_defect",
        "engine_defect",
        "fixture_defect",
        "unresolved"
      ]
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "scenario_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^HP-S[0-9]{3}$" }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "summary": { "type": "string", "minLength": 1 },
    "raw_observation": { "type": "string", "minLength": 1 },
    "normalized_effect": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "minLength": 1 },
    "upstream": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["project", "issue_url", "repro_path"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "issue_url": { "type": ["string", "null"], "format": "uri" },
        "repro_path": { "type": ["string", "null"] }
      }
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^HP-F[0-9]{4}$" }
    }
  }
}
