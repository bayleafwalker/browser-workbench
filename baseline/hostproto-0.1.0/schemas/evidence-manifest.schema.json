{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hostproto:schema:evidence-manifest:0.1",
  "title": "hostproto evidence manifest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "evidence_id",
    "created_at",
    "protocol_version",
    "scenario_corpus",
    "chrome_bundle_sha256",
    "fixture_manifest_sha256",
    "backend",
    "adapter",
    "environment",
    "repetitions",
    "scenarios",
    "files"
  ],
  "properties": {
    "manifest_version": { "const": "0.1" },
    "evidence_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "created_at": { "type": "string", "format": "date-time" },
    "protocol_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "scenario_corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "const": "hostproto-reference-chrome" },
        "version": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "chrome_bundle_sha256": { "$ref": "#/$defs/sha256" },
    "fixture_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "revision", "profile_mode"],
      "properties": {
        "name": { "enum": ["mock", "webkitgtk", "servo"] },
        "version": { "type": "string", "minLength": 1 },
        "revision": { "type": ["string", "null"] },
        "profile_mode": { "const": "ephemeral-empty" },
        "patches": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "dirty"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "display_protocol", "gtk", "rust", "graphics"],
      "properties": {
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "display_protocol": { "enum": ["wayland", "x11", "headless", "other"] },
        "gtk": { "type": "string" },
        "rust": { "type": "string" },
        "graphics": { "type": "string" },
        "package_snapshot_ref": { "type": ["string", "null"] }
      }
    },
    "repetitions": { "type": "integer", "minimum": 1 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcomes", "stable", "finding_ids"],
        "properties": {
          "id": { "type": "string", "pattern": "^HP-S[0-9]{3}$" },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["pass", "fail", "unsupported", "blocked", "invalid"] }
          },
          "stable": { "type": "boolean" },
          "finding_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^HP-F[0-9]{4}$" }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256", "size_bytes", "media_type"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": {
            "enum": [
              "raw_trace",
              "normalized_trace",
              "scenario_report",
              "finding",
              "screenshot",
              "chrome_bundle",
              "fixture_manifest",
              "build_manifest",
              "log"
            ]
          },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "media_type": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
