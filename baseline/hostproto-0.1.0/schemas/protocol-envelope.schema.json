{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hostproto:schema:protocol-envelope:0.1",
  "title": "hostproto protocol envelope 0.1",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/welcome" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/cancel" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "semantics", "source", "notes"],
      "properties": {
        "status": {
          "enum": ["supported", "unsupported", "experimental"]
        },
        "semantics": {
          "enum": ["exact", "normalized", "partial", "none"]
        },
        "source": {
          "enum": ["engine", "adapter", "host"]
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "maxLength": 500 },
          "maxItems": 20
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "unsupported" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "semantics": { "const": "none" } }
          }
        }
      ]
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "supported_versions", "required_capabilities"],
      "properties": {
        "kind": { "const": "hello" },
        "supported_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/version" }
        },
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          }
        }
      }
    },
    "welcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocol_version", "session_id", "capabilities"],
      "properties": {
        "kind": { "const": "welcome" },
        "protocol_version": { "$ref": "#/$defs/version" },
        "session_id": { "$ref": "#/$defs/identifier" },
        "capabilities": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "additionalProperties": { "$ref": "#/$defs/capability" }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocol_version", "id", "method", "params"],
      "properties": {
        "kind": { "const": "request" },
        "protocol_version": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/identifier" },
        "method": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "params": { "type": "object" },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "data": {},
        "backend_detail_ref": { "$ref": "#/$defs/identifier" },
        "outcome": { "enum": ["known", "unknown"] }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocol_version", "id"],
      "properties": {
        "kind": { "const": "response" },
        "protocol_version": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/identifier" },
        "result": {},
        "error": { "$ref": "#/$defs/error" }
      },
      "oneOf": [
        { "required": ["result"], "not": { "required": ["error"] } },
        { "required": ["error"], "not": { "required": ["result"] } }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocol_version", "seq", "name", "payload"],
      "properties": {
        "kind": { "const": "event" },
        "protocol_version": { "$ref": "#/$defs/version" },
        "seq": { "type": "integer", "minimum": 0 },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "payload": { "type": "object" },
        "cause_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocol_version", "id"],
      "properties": {
        "kind": { "const": "cancel" },
        "protocol_version": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/identifier" },
        "reason": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
