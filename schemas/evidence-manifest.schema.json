{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/browser-workbench/evidence-manifest-v1.schema.json",
  "title": "Browser workbench evidence manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "artifacts", "root_digest"],
  "properties": {
    "schema_version": {"const": "browser-workbench.evidence-manifest/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "size_bytes", "sha256", "surface"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "surface": {"enum": ["raw", "normalized", "redacted", "diagnostic", "contract"]},
          "source_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "root_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "redaction": {"type": "object"},
    "complete": {"type": "boolean"}
  }
}
