{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/browser-workbench/run-spec-v1.schema.json",
  "title": "Browser workbench run specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "backend", "required_capabilities", "workflow", "gates", "evidence"],
  "properties": {
    "schema_version": {"const": "browser-workbench.run/v1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "variant"],
      "properties": {
        "kind": {"enum": ["mock", "webkitgtk", "playwright", "servo-gtk"]},
        "variant": {"type": "string", "minLength": 1, "maxLength": 128},
        "expected_identity": {"type": "object"}
      }
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_providers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["engine", "adapter", "host", "injected", "oracle", "mock"]}
    },
    "workflow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "method", "params"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "method": {"enum": ["session.create", "page.navigate", "page.observe", "page.act", "page.await", "session.checkpoint", "session.export", "run.compare"]},
          "params": {"type": "object"},
          "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 300000},
          "expect": {"type": "object"}
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "required"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["contract", "capability", "execution", "evidence", "determinism", "comparison", "recovery", "native"]},
          "required": {"type": "boolean"},
          "params": {"type": "object"}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mutation": {"enum": ["allow", "forbid"]},
        "profile": {"enum": ["ephemeral", "persistent"]},
        "redaction_profile": {"type": "string"},
        "single_writer": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "normalized", "max_artifact_bytes"],
      "properties": {
        "raw": {"type": "boolean"},
        "normalized": {"type": "boolean"},
        "max_artifact_bytes": {"type": "integer", "minimum": 1024, "maximum": 1073741824},
        "redaction_profile": {"type": "string"}
      }
    }
  }
}
