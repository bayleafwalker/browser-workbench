{
  "allowed_providers": [
    "engine",
    "host",
    "injected"
  ],
  "backend": {
    "kind": "webkitgtk",
    "variant": "stable-ephemeral"
  },
  "evidence": {
    "max_artifact_bytes": 1048576,
    "normalized": true,
    "raw": true,
    "redaction_profile": "default"
  },
  "gates": [
    {
      "id": "contract",
      "kind": "contract",
      "required": true
    },
    {
      "id": "capabilities",
      "kind": "capability",
      "required": true
    },
    {
      "id": "execution",
      "kind": "execution",
      "required": true
    },
    {
      "id": "evidence",
      "kind": "evidence",
      "required": true
    },
    {
      "id": "native",
      "kind": "native",
      "required": true
    }
  ],
  "policy": {
    "mutation": "forbid",
    "profile": "ephemeral",
    "redaction_profile": "default",
    "single_writer": true
  },
  "required_capabilities": [
    "session.create",
    "page.navigate",
    "page.await",
    "page.observe.state"
  ],
  "run_id": "oracle-corpus-WB-S008-webkitgtk",
  "schema_version": "browser-workbench.run/v1",
  "workflow": [
    {
      "deadline_ms": 60000,
      "method": "session.create",
      "params": {
        "client": {
          "id": "oracle-client",
          "kind": "agent"
        },
        "profile": {
          "mode": "ephemeral",
          "name": "oracle-corpus"
        },
        "viewport": {
          "height": 768,
          "width": 1024
        }
      },
      "step_id": "create"
    },
    {
      "deadline_ms": 60000,
      "method": "page.navigate",
      "params": {
        "client_id": "oracle-client",
        "page_id": {
          "$step": "create",
          "path": "page_id"
        },
        "url": "http://127.0.0.1:38775/upload.html"
      },
      "step_id": "navigate"
    },
    {
      "deadline_ms": 60000,
      "method": "page.await",
      "params": {
        "conditions": [
          {
            "equals": "idle",
            "kind": "load_state"
          },
          {
            "equals": "Workbench Fixture Upload",
            "kind": "title"
          }
        ],
        "deadline_ms": 30000,
        "page_id": {
          "$step": "create",
          "path": "page_id"
        }
      },
      "step_id": "await"
    },
    {
      "deadline_ms": 60000,
      "expect": {
        "equals": "file",
        "path": "data.targets.0.role"
      },
      "method": "page.observe",
      "params": {
        "max_bytes": 262144,
        "page_id": {
          "$step": "create",
          "path": "page_id"
        },
        "projection": [
          "targets"
        ],
        "since_event": 0
      },
      "step_id": "targets"
    },
    {
      "deadline_ms": 60000,
      "expect": {
        "equals": "upload",
        "path": "effects.0.kind"
      },
      "method": "page.act",
      "params": {
        "client_id": "oracle-client",
        "intent": {
          "kind": "upload",
          "path": "/projects/dev/browser-workbench/examples/fixtures/upload.txt"
        },
        "page_id": {
          "$step": "create",
          "path": "page_id"
        },
        "target": {
          "$step": "targets",
          "path": "data.targets.0"
        }
      },
      "step_id": "upload"
    },
    {
      "deadline_ms": 60000,
      "method": "page.act",
      "params": {
        "client_id": "oracle-client",
        "intent": {
          "kind": "click"
        },
        "page_id": {
          "$step": "create",
          "path": "page_id"
        },
        "target": {
          "$step": "targets",
          "path": "data.targets.1"
        }
      },
      "step_id": "click-download"
    },
    {
      "deadline_ms": 60000,
      "method": "page.await",
      "params": {
        "conditions": [
          {
            "equals": "download.finished",
            "kind": "event_kind"
          }
        ],
        "deadline_ms": 30000,
        "page_id": {
          "$step": "create",
          "path": "page_id"
        }
      },
      "step_id": "await-download"
    },
    {
      "deadline_ms": 60000,
      "expect": {
        "path": "data.downloads.0.download_id",
        "truthy": true
      },
      "method": "page.observe",
      "params": {
        "max_bytes": 32768,
        "page_id": {
          "$step": "create",
          "path": "page_id"
        },
        "projection": [
          "downloads"
        ],
        "since_event": 0
      },
      "step_id": "downloads"
    },
    {
      "deadline_ms": 60000,
      "expect": {
        "equals": "quarantined",
        "path": "effects.0.status"
      },
      "method": "page.act",
      "params": {
        "client_id": "oracle-client",
        "intent": {
          "download_id": {
            "$step": "downloads",
            "path": "data.downloads.0.download_id"
          },
          "kind": "download.accept"
        },
        "page_id": {
          "$step": "create",
          "path": "page_id"
        }
      },
      "step_id": "accept"
    }
  ]
}
