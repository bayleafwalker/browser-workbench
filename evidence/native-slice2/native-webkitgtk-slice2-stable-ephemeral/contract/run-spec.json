{
  "allowed_providers": [
    "engine",
    "host",
    "injected"
  ],
  "backend": {
    "kind": "webkitgtk",
    "variant": "stable-ephemeral"
  },
  "evidence": {
    "max_artifact_bytes": 1048576,
    "normalized": true,
    "raw": true,
    "redaction_profile": "default"
  },
  "gates": [
    {
      "id": "contract",
      "kind": "contract",
      "required": true
    },
    {
      "id": "capabilities",
      "kind": "capability",
      "required": true
    },
    {
      "id": "execution",
      "kind": "execution",
      "required": true
    },
    {
      "id": "evidence",
      "kind": "evidence",
      "required": true
    },
    {
      "id": "native",
      "kind": "native",
      "required": true
    }
  ],
  "policy": {
    "mutation": "forbid",
    "profile": "ephemeral",
    "redaction_profile": "default",
    "single_writer": true
  },
  "required_capabilities": [
    "session.create",
    "page.navigate",
    "page.await",
    "page.observe.state",
    "page.observe.dom",
    "page.observe.screenshot",
    "page.act.javascript",
    "session.export"
  ],
  "run_id": "native-webkitgtk-slice2-stable-ephemeral",
  "schema_version": "browser-workbench.run/v1",
  "workflow": [
    {
      "deadline_ms": 60000,
      "method": "session.create",
      "params": {
        "client": {
          "id": "slice2-client",
          "kind": "agent"
        },
        "profile": {
          "mode": "ephemeral",
          "name": "slice2"
        },
        "viewport": {
          "height": 768,
          "width": 1024
        }
      },
      "step_id": "create"
    },
    {
      "deadline_ms": 60000,
      "expect": {
        "equals": true,
        "path": "accepted"
      },
      "method": "page.navigate",
      "params": {
        "client_id": "slice2-client",
        "page_id": {
          "$step": "create",
          "path": "page_id"
        },
        "url": "http://127.0.0.1:35739/console.html"
      },
      "step_id": "navigate"
    },
    {
      "deadline_ms": 60000,
      "expect": {
        "equals": true,
        "path": "satisfied"
      },
      "method": "page.await",
      "params": {
        "conditions": [
          {
            "equals": "idle",
            "kind": "load_state"
          },
          {
            "equals": "Workbench Fixture Console",
            "kind": "title"
          }
        ],
        "deadline_ms": 30000,
        "page_id": {
          "$step": "create",
          "path": "page_id"
        }
      },
      "step_id": "await"
    },
    {
      "deadline_ms": 60000,
      "expect": {
        "equals": "deterministic-fixture-console",
        "path": "effects.0.value"
      },
      "method": "page.act",
      "params": {
        "client_id": "slice2-client",
        "intent": {
          "kind": "javascript",
          "value": "document.getElementById('marker').textContent"
        },
        "page_id": {
          "$step": "create",
          "path": "page_id"
        },
        "preconditions": {
          "title": "Workbench Fixture Console"
        }
      },
      "step_id": "javascript"
    },
    {
      "deadline_ms": 60000,
      "expect": {
        "equals": false,
        "path": "lossy"
      },
      "method": "page.observe",
      "params": {
        "max_bytes": 262144,
        "page_id": {
          "$step": "create",
          "path": "page_id"
        },
        "projection": [
          "state",
          "dom",
          "console",
          "network",
          "screenshot"
        ],
        "since_event": 0
      },
      "step_id": "observe"
    },
    {
      "deadline_ms": 60000,
      "method": "session.export",
      "params": {
        "include_raw": true,
        "max_bytes": 1048576,
        "metadata": {
          "purpose": "native-slice-2"
        }
      },
      "step_id": "export"
    }
  ]
}
