{
  "schema_version": "browser-workbench.run/v1",
  "run_id": "native-webkitgtk-slice1",
  "backend": {"kind": "webkitgtk", "variant": "stable-ephemeral"},
  "required_capabilities": ["session.create", "page.navigate", "page.observe.state", "page.await", "session.export"],
  "allowed_providers": ["engine", "host"],
  "workflow": [
    {
      "step_id": "create",
      "method": "session.create",
      "deadline_ms": 60000,
      "params": {
        "client": {"id": "slice1-client", "kind": "agent"},
        "profile": {"mode": "ephemeral", "name": "slice1"},
        "viewport": {"width": 1024, "height": 768}
      }
    },
    {
      "step_id": "navigate",
      "method": "page.navigate",
      "deadline_ms": 60000,
      "params": {
        "page_id": {"$step": "create", "path": "page_id"},
        "client_id": "slice1-client",
        "url": "${FIXTURE_BASE_URL}index.html"
      },
      "expect": {"path": "accepted", "equals": true}
    },
    {
      "step_id": "await",
      "method": "page.await",
      "deadline_ms": 60000,
      "params": {
        "page_id": {"$step": "create", "path": "page_id"},
        "conditions": [
          {"kind": "load_state", "equals": "idle"},
          {"kind": "url", "equals": "${FIXTURE_BASE_URL}index.html"},
          {"kind": "title", "equals": "Workbench Fixture Index"}
        ],
        "deadline_ms": 30000
      },
      "expect": {"path": "satisfied", "equals": true}
    },
    {
      "step_id": "observe",
      "method": "page.observe",
      "deadline_ms": 60000,
      "params": {
        "page_id": {"$step": "create", "path": "page_id"},
        "projection": ["state", "raw-events"],
        "since_event": 0,
        "max_bytes": 65536
      },
      "expect": {"path": "data.state.title", "equals": "Workbench Fixture Index"}
    },
    {
      "step_id": "export",
      "method": "session.export",
      "deadline_ms": 60000,
      "params": {"include_raw": true, "metadata": {"purpose": "native-slice-1"}, "max_bytes": 1048576}
    }
  ],
  "gates": [
    {"id": "contract", "kind": "contract", "required": true},
    {"id": "capabilities", "kind": "capability", "required": true},
    {"id": "execution", "kind": "execution", "required": true},
    {"id": "evidence", "kind": "evidence", "required": true},
    {"id": "native", "kind": "native", "required": true}
  ],
  "policy": {"mutation": "forbid", "profile": "ephemeral", "redaction_profile": "default", "single_writer": true},
  "evidence": {"raw": true, "normalized": true, "max_artifact_bytes": 1048576, "redaction_profile": "default"}
}
